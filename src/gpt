#!/usr/bin/env python3

import os
import click
from openai import OpenAI
import sys
import readline
import tiktoken
import json

def gpt(content, model, temperature, top_p, stream, stop, max_completion_tokens, reasoning_effort, verbosity, conversation_history, file_attachments=None):
    """Make a GPT API call with the modern OpenAI SDK."""
    client = OpenAI(
        api_key=os.getenv("OPENAI_API_KEY"),
        organization=os.getenv("OPENAI_ORGANIZATION")
    )

    # Handle file uploads if provided
    # Supports: PDF, images (PNG, JPG, GIF, WEBP), and Office docs (DOCX, PPTX, XLSX)
    file_ids = []
    if file_attachments:
        for file_path in file_attachments:
            with open(file_path, "rb") as file_obj:
                uploaded_file = client.files.create(
                    file=file_obj,
                    purpose="user_data"
                )
                file_ids.append(uploaded_file.id)

    # Build message content
    if file_ids:
        # If files are attached, content must be a list of content parts
        message_content = []
        for file_id in file_ids:
            message_content.append({"type": "file", "file": {"file_id": file_id}})
        message_content.append({"type": "text", "text": content})
    else:
        # Standard text-only content
        message_content = content

    # Build the API parameters
    params = {
        "model": model,
        "messages": [*conversation_history, {"role": "user", "content": message_content}],
        "temperature": temperature,
        "top_p": top_p,
        "stream": stream,
    }

    # Add optional parameters only if specified
    if stop:
        params["stop"] = stop
    if max_completion_tokens:
        params["max_completion_tokens"] = max_completion_tokens

    # Add GPT-5 specific parameters for reasoning models
    if model.startswith("gpt-5") or model.startswith("o"):
        if reasoning_effort:
            params["reasoning_effort"] = reasoning_effort
        if verbosity:
            params["verbosity"] = verbosity

    response = client.chat.completions.create(**params)
    return response.choices[0].message.content


def count_tokens(text, model):
    """Count tokens in text using tiktoken."""
    try:
        enc = tiktoken.encoding_for_model(model)
    except KeyError:
        # Fallback to gpt-4 encoding if model not recognized
        enc = tiktoken.encoding_for_model("gpt-4")

    tokens = enc.encode(text)
    return len(tokens), tokens


def get_version():
    """Get version from git describe, fallback to 'unknown'."""
    import subprocess
    try:
        version = subprocess.check_output(
            ['git', 'describe', '--tags', '--always'],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        # Remove leading 'v' if present
        if version.startswith('v'):
            version = version[1:]
        return version
    except:
        return 'unknown'

@click.command(context_settings={"ignore_unknown_options": True, "allow_extra_args": True, "help_option_names": ['-h', '--help']})
@click.version_option(version=get_version(), prog_name='gpt-toolkit')
@click.option('-m', '--model', default='gpt-5', help='Specifies the AI model to use (default: gpt-5).')
@click.option('-5', 'model_set_to_gpt5', is_flag=True, help='Sets the model to gpt-5 (default)')
@click.option('-4', 'model_set_to_gpt4', is_flag=True, help='Sets the model to gpt-4')
@click.option('--mini', 'model_set_to_mini', is_flag=True, help='Sets the model to gpt-5-mini')
@click.option('--nano', 'model_set_to_nano', is_flag=True, help='Sets the model to gpt-5-nano')
@click.option('--temperature', type=float, default=1.0, help='Sets the sampling temperature between 0 and 2.')
@click.option('--top-p', type=float, default=1.0, help='Sets nucleus sampling parameter.')
@click.option('--stream', type=bool, default=False, help='Stream partial message deltas.')
@click.option('--stop', type=str, default=None, help='Up to 4 sequences where API stops generating tokens.')
@click.option('--max-completion-tokens', type=int, default=None, help='Maximum tokens to generate.')
@click.option('--reasoning-effort', type=click.Choice(['minimal', 'low', 'medium', 'high'], case_sensitive=False),
              default='medium', help='Reasoning effort for GPT-5 models (default: medium).')
@click.option('--verbosity', type=click.Choice(['low', 'medium', 'high'], case_sensitive=False),
              default='medium', help='Output verbosity for GPT-5 models (default: medium).')
@click.option('--repl', is_flag=True, help='Enable REPL mode for conversations.')
@click.option('--file', 'file_attachments', multiple=True, type=click.Path(exists=True),
              help='Attach file(s) to the prompt (PDF, images, Office docs). Can be used multiple times.')
@click.option('--pdf', 'pdf_deprecated', multiple=True, type=click.Path(exists=True),
              help='[DEPRECATED] Use --file instead. Attach PDF file(s) to the prompt.')
@click.option('--tokens', is_flag=True, help='Count tokens in input instead of calling API. Outputs JSON with count and token IDs.')
def main(model, model_set_to_gpt5, model_set_to_gpt4, model_set_to_mini, model_set_to_nano,
         repl, temperature, top_p, stream, stop, max_completion_tokens, reasoning_effort, verbosity,
         file_attachments, pdf_deprecated, tokens):
    """
    GPT command-line interface - a simple text filter for GPT models.

    Reads prompt from stdin (or file with -f), sends to GPT API, outputs to stdout.

    Features:
    - File attachment support: PDF, images (PNG, JPG, GIF, WEBP), Office docs (DOCX, PPTX, XLSX)
    - Token counting (--tokens)
    - REPL mode (--repl)
    - GPT-5 reasoning controls
    """
    # Merge --pdf (deprecated) into --file for backwards compatibility
    all_files = list(file_attachments) + list(pdf_deprecated)

    # Handle model shortcuts
    if model_set_to_gpt4:
        model = 'gpt-4'
    elif model_set_to_mini:
        model = 'gpt-5-mini'
    elif model_set_to_nano:
        model = 'gpt-5-nano'
    # -5 flag or default keeps model='gpt-5'

    # Token counting mode
    if tokens:
        if repl:
            raise click.UsageError("Cannot use --tokens with --repl mode")
        if all_files:
            raise click.UsageError("Cannot use --tokens with --file/--pdf (tokens are for text only)")

        text = sys.stdin.read()

        # Count tokens
        count, token_ids = count_tokens(text, model)

        # Output as JSON
        result = {
            "token_count": count,
            "token_ids": token_ids,
            "model": model
        }
        print(json.dumps(result, indent=2))
        return

    if repl and all_files:
        raise click.UsageError("File attachments not supported in REPL mode")

    # Use merged file list (None if empty)
    files_to_attach = all_files if all_files else None

    if repl:
        # REPL mode - interactive conversation
        conversation_history = []
        click.echo(f"GPT REPL Mode (model: {model}). Type 'exit' to quit.")
        while True:
            try:
                content = input("> ")
            except (EOFError, KeyboardInterrupt):
                click.echo("\nExiting...")
                return

            if content.lower() in ["exit", "quit"]:
                return

            try:
                assistant_response = gpt(
                    content, model, temperature, top_p, stream, stop,
                    max_completion_tokens, reasoning_effort, verbosity, conversation_history
                )
                conversation_history.append({"role": "user", "content": content})
                conversation_history.append({"role": "assistant", "content": assistant_response})
                click.echo(assistant_response)
            except Exception as e:
                click.echo(f"Error: {e}", err=True)
    else:
        # Standard filter mode - text in, text out
        message = sys.stdin.read()

        try:
            output = gpt(
                message, model, temperature, top_p, stream, stop,
                max_completion_tokens, reasoning_effort, verbosity, [], files_to_attach
            )
            print(output)
        except Exception as e:
            click.echo(f"Error: {e}", err=True)
            sys.exit(1)


if __name__ == "__main__":
    main()  # pylint: disable=no-value-for-parameter

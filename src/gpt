#!/usr/bin/env python3

import os
import sys
import time
import json
from datetime import datetime, timezone
import base64
import mimetypes
import readline
import click
import tiktoken
from openai import OpenAI, APIConnectionError, APITimeoutError, APIError


def ts():
    """Return ISO 8601 UTC timestamp."""
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def validate_model(model):
    """Validate that the model is allowed (only GPT-4o and GPT-5 series)."""
    allowed_prefixes = ['gpt-4o', 'gpt-5']

    # Check if model starts with any allowed prefix
    if not any(model.startswith(prefix) for prefix in allowed_prefixes):
        raise click.UsageError(
            f"Model '{model}' is not allowed. Only GPT-4o and GPT-5 models are supported.\n"
            f"Allowed models: gpt-4o, gpt-5, gpt-5-mini, gpt-5-nano, gpt-5-codex, etc."
        )

def uses_responses_api(model):
    """Determine if a model uses the Responses API instead of Chat Completions API."""
    # Models that use the Responses API (/v1/responses)
    responses_api_models = ['gpt-5-codex']
    return model in responses_api_models or model.endswith('-codex')

def is_image_file(file_path):
    """Detect if a file is an image based on extension."""
    image_extensions = {'.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp'}
    ext = os.path.splitext(file_path)[1].lower()
    return ext in image_extensions

def encode_image_to_base64(file_path):
    """Encode an image file to base64."""
    with open(file_path, "rb") as image_file:
        return base64.b64encode(image_file.read()).decode('utf-8')

def get_image_mime_type(file_path):
    """Get MIME type for an image file."""
    mime_type, _ = mimetypes.guess_type(file_path)
    if mime_type and mime_type.startswith('image/'):
        return mime_type
    # Fallback based on extension
    ext = os.path.splitext(file_path)[1].lower()
    mime_map = {
        '.png': 'image/png',
        '.jpg': 'image/jpeg',
        '.jpeg': 'image/jpeg',
        '.gif': 'image/gif',
        '.webp': 'image/webp',
        '.bmp': 'image/bmp'
    }
    return mime_map.get(ext, 'image/jpeg')


def stream_response(client, params, max_retries=5, debug=False, fail_after_chunks=None):
    """Stream a GPT response with silent retry on connection errors.

    Only counts toward max_retries if no progress was made.
    If we got some data before failing, retry counter resets.
    On retry with partial data, asks model to continue from where it stopped.
    """
    params["stream"] = True
    consecutive_failures = 0
    chunk_count = 0
    accumulated_response = ""
    original_messages = params["messages"].copy()
    start_time = time.time()

    if debug:
        click.echo(f"[{ts()}] model={params.get('model')} max_retries={max_retries}", err=True)

    while consecutive_failures <= max_retries:
        got_data_this_attempt = False
        attempt_start = time.time()
        try:
            if debug:
                click.echo(f"[{ts()}] connecting to API...", err=True)
            stream = client.chat.completions.create(**params)
            if debug:
                connect_time = time.time() - attempt_start
                click.echo(f"[{ts()}] streaming started (connect: {connect_time:.2f}s)", err=True)
            for chunk in stream:
                if chunk.choices and chunk.choices[0].delta.content:
                    text = chunk.choices[0].delta.content
                    sys.stdout.write(text)
                    sys.stdout.flush()
                    accumulated_response += text
                    got_data_this_attempt = True
                    chunk_count += 1
                    if debug:
                        click.echo(f"\r[{ts()}] chunks={chunk_count} chars={len(accumulated_response)}", nl=False, err=True)
                    if fail_after_chunks and chunk_count >= fail_after_chunks:
                        import httpx
                        raise APIConnectionError(request=httpx.Request("POST", "https://api.openai.com"))
            if accumulated_response and not accumulated_response.endswith('\n'):
                sys.stdout.write('\n')
                sys.stdout.flush()
            if debug:
                total_time = time.time() - start_time
                click.echo(f"\n[{ts()}] complete: {chunk_count} chunks, {len(accumulated_response)} chars in {total_time:.2f}s", err=True)
            return
        except (APIConnectionError, APITimeoutError, APIError) as e:
            error_type = type(e).__name__
            attempt_duration = time.time() - attempt_start
            chunk_count = 0  # Reset chunk count for next attempt
            if got_data_this_attempt:
                # Made progress - reset failure counter, add partial to messages for continuation
                consecutive_failures = 0
                # Use assistant_prefix to continue from partial response
                params["messages"] = original_messages + [
                    {"role": "assistant", "content": accumulated_response}
                ]
                if debug:
                    click.echo(f"\n[{ts()}] {error_type} after {attempt_duration:.2f}s, got {len(accumulated_response)} chars, continuing", err=True)
            else:
                # No progress - count toward giving up
                consecutive_failures += 1
                if debug:
                    click.echo(f"\n[{ts()}] {error_type} after {attempt_duration:.2f}s: {e}", err=True)
                    click.echo(f"[{ts()}] no progress, failures={consecutive_failures}/{max_retries}", err=True)

            if consecutive_failures > max_retries:
                if debug:
                    click.echo(f"[{ts()}] giving up after {max_retries} consecutive failures", err=True)
                raise

            wait_time = min(2 ** consecutive_failures, 8)
            if debug:
                click.echo(f"[{ts()}] waiting {wait_time}s before retry", err=True)
            time.sleep(wait_time)


def gpt(content, model, temperature, top_p, stream, stop, max_completion_tokens, reasoning_effort, verbosity, conversation_history, file_attachments=None, detail="auto", timeout=180.0, debug=False, fail_after_chunks=None):
    """Make a GPT API call with the modern OpenAI SDK."""
    client = OpenAI(
        api_key=os.getenv("OPENAI_API_KEY"),
        organization=os.getenv("OPENAI_ORGANIZATION"),
        timeout=timeout,
        max_retries=0   # We handle retries ourselves
    )

    # Check if this model uses the Responses API
    if uses_responses_api(model):
        # Responses API does not support conversation history or file attachments
        if conversation_history:
            raise click.UsageError(f"Model {model} does not support conversation history (REPL mode)")
        if file_attachments:
            raise click.UsageError(f"Model {model} does not support file attachments")

        # Build Responses API parameters
        params = {
            "model": model,
            "input": content,
            "temperature": temperature,
            "top_p": top_p,
            "stream": stream,
        }

        # Add optional parameters
        if stop:
            params["stop"] = stop
        if max_completion_tokens:
            # Responses API uses max_output_tokens instead of max_completion_tokens
            params["max_output_tokens"] = max_completion_tokens

        # Note: Responses API doesn't support reasoning_effort or verbosity parameters

        # Make the Responses API call
        response = client.responses.create(**params)
        return response.output_text

    else:
        # Chat Completions API (original implementation)
        # Handle file attachments if provided
        # Images: base64 encoded (PNG, JPG, GIF, WEBP)
        # Documents: Files API (PDF, DOCX, PPTX, XLSX)
        message_content = []

        if file_attachments:
            for file_path in file_attachments:
                if is_image_file(file_path):
                    # Images: use base64 encoding with vision API
                    base64_image = encode_image_to_base64(file_path)
                    mime_type = get_image_mime_type(file_path)
                    message_content.append({
                        "type": "image_url",
                        "image_url": {
                            "url": f"data:{mime_type};base64,{base64_image}",
                            "detail": detail
                        }
                    })
                else:
                    # PDFs and Office docs: use Files API
                    with open(file_path, "rb") as file_obj:
                        uploaded_file = client.files.create(
                            file=file_obj,
                            purpose="user_data"
                        )
                        message_content.append({"type": "file", "file": {"file_id": uploaded_file.id}})

        # Add text content
        if file_attachments:
            # Files were attached, content is already a list
            message_content.append({"type": "text", "text": content})
        else:
            # No files, use simple string content
            message_content = content

        # Build the API parameters
        params = {
            "model": model,
            "messages": [*conversation_history, {"role": "user", "content": message_content}],
            "temperature": temperature,
            "top_p": top_p,
        }

        # Add optional parameters only if specified
        if stop:
            params["stop"] = stop
        if max_completion_tokens:
            params["max_completion_tokens"] = max_completion_tokens

        # Add GPT-5 specific parameters for reasoning models
        if model.startswith("gpt-5") or model.startswith("o"):
            if reasoning_effort:
                params["reasoning_effort"] = reasoning_effort
            if verbosity:
                params["verbosity"] = verbosity

        return stream_response(client, params, debug=debug, fail_after_chunks=fail_after_chunks)


def count_tokens(text, model):
    """Count tokens in text using tiktoken."""
    try:
        enc = tiktoken.encoding_for_model(model)
    except KeyError:
        # Fallback to gpt-4 encoding if model not recognized
        enc = tiktoken.encoding_for_model("gpt-4")

    tokens = enc.encode(text)
    return len(tokens), tokens


def get_version():
    """Get version from git describe, fallback to 'unknown'."""
    import subprocess
    try:
        version = subprocess.check_output(
            ['git', 'describe', '--tags', '--always'],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        # Remove leading 'v' if present
        if version.startswith('v'):
            version = version[1:]
        return version
    except:
        return 'unknown'

@click.command(context_settings={"ignore_unknown_options": True, "allow_extra_args": True, "help_option_names": ['-h', '--help']})
@click.version_option(version=get_version(), prog_name='gpt-toolkit')
@click.option('-m', '--model', default='gpt-5', help='Specifies the AI model to use (default: gpt-5).')
@click.option('-5', 'model_set_to_gpt5', is_flag=True, help='Sets the model to gpt-5 (default)')
@click.option('-4', 'model_set_to_gpt4', is_flag=True, help='Sets the model to gpt-4o')
@click.option('--mini', 'model_set_to_mini', is_flag=True, help='Sets the model to gpt-5-mini')
@click.option('--nano', 'model_set_to_nano', is_flag=True, help='Sets the model to gpt-5-nano')
@click.option('--codex', 'model_set_to_codex', is_flag=True, help='Sets the model to gpt-5-codex (uses Responses API)')
@click.option('--temperature', type=float, default=1.0, help='Sets the sampling temperature between 0 and 2.')
@click.option('--top-p', type=float, default=1.0, help='Sets nucleus sampling parameter.')
@click.option('--stream', type=bool, default=False, help='Stream partial message deltas.')
@click.option('--stop', type=str, default=None, help='Up to 4 sequences where API stops generating tokens.')
@click.option('--max-completion-tokens', type=int, default=None, help='Maximum tokens to generate.')
@click.option('--reasoning-effort', type=click.Choice(['minimal', 'low', 'medium', 'high'], case_sensitive=False),
              default='medium', help='Reasoning effort for GPT-5 models (default: medium).')
@click.option('--verbosity', type=click.Choice(['low', 'medium', 'high'], case_sensitive=False),
              default='medium', help='Output verbosity for GPT-5 models (default: medium).')
@click.option('--repl', is_flag=True, help='Enable REPL mode for conversations.')
@click.option('--file', 'file_attachments', multiple=True, type=click.Path(exists=True),
              help='Attach file(s) to the prompt. Images (PNG/JPG/GIF/WEBP) use vision, PDFs/Office docs use Files API.')
@click.option('--detail', type=click.Choice(['low', 'high', 'auto'], case_sensitive=False),
              default='auto', help='Vision detail level for images: low (fast), high (detailed), auto (default).')
@click.option('--pdf', 'pdf_deprecated', multiple=True, type=click.Path(exists=True),
              help='[DEPRECATED] Use --file instead. Attach PDF file(s) to the prompt.')
@click.option('--tokens', is_flag=True, help='Count tokens in input instead of calling API. Outputs JSON with count and token IDs.')
@click.option('--timeout', type=float, default=180.0, help='Request timeout in seconds (default: 180).')
@click.option('-v', '--verbose', 'debug', is_flag=True, help='Show progress and retry info on stderr.')
@click.option('--fail-after-chunks', type=int, default=None, help='Simulate network failure after N chunks (for testing).')
def main(model, model_set_to_gpt5, model_set_to_gpt4, model_set_to_mini, model_set_to_nano, model_set_to_codex,
         repl, temperature, top_p, stream, stop, max_completion_tokens, reasoning_effort, verbosity,
         file_attachments, detail, pdf_deprecated, tokens, timeout, debug, fail_after_chunks):
    """
    GPT command-line interface - a Unix-style text filter for GPT models.

    IMPORTANT: This is a STDIN/STDOUT filter. Input comes from STDIN, output goes to STDOUT.
    DO NOT pass your prompt as a positional argument!

    \b
    CORRECT USAGE:
      echo "Count from 1 to 10" | gpt
      cat file.txt | gpt
      gpt < prompt.txt
      cat data.txt | gpt <<'EOF'
      Analyze this data and summarize the key points.
      EOF

    \b
    CORRECT USAGE (with files):
      echo "Summarize this PDF" | gpt --file document.pdf
      echo "What's in this image?" | gpt --file photo.jpg
      echo "Compare these images" | gpt --file img1.png --file img2.png
      echo "Analyze this data" | gpt --file data.xlsx --file report.docx
      echo "Detailed analysis" | gpt --file diagram.png --detail high

    \b
    CORRECT USAGE (token counting):
      echo "How many tokens is this?" | gpt --tokens
      cat large-file.txt | gpt --tokens

    \b
    CORRECT USAGE (REPL mode):
      gpt --repl

    \b
    ❌ WRONG - DO NOT DO THIS:
      gpt "your prompt here"              # NO! Prompt is not a positional arg!
      gpt --file data.csv "analyze this"  # NO! Input must come from stdin!
      cat file.txt | gpt "summarize"      # NO! Don't pass prompt as argument!

    \b
    WHY THIS MATTERS:
    gpt is designed as a Unix filter for pipes and redirection. Prompts MUST come
    via stdin (echo, cat, heredoc, <, |). This enables composability:
      cat file1 file2 file3 | gpt > output.txt
      for f in *.txt; do cat "$f" | gpt >> results.txt; done

    \b
    FEATURES:
    - Vision: Images (PNG/JPG/JPEG/GIF/WEBP/BMP) via base64 encoding
    - Documents: PDF, Office files (DOCX/PPTX/XLSX) via Files API
    - Image detail: --detail (low/high/auto) controls vision processing quality
    - Token counting: --tokens (outputs JSON, no API call)
    - REPL mode: --repl (interactive conversation)
    - GPT-5 reasoning: --reasoning-effort (minimal/low/medium/high)
    - Model shortcuts: -4 (GPT-4o), --mini (GPT-5-mini), --nano (GPT-5-nano), --codex (GPT-5-Codex)
    - Model restriction: Only GPT-4o and GPT-5 series allowed
    - GPT-5 Codex: Uses Responses API (no file attachments or REPL mode support)
    """
    # Merge --pdf (deprecated) into --file for backwards compatibility
    all_files = list(file_attachments) + list(pdf_deprecated)

    # Handle model shortcuts
    if model_set_to_gpt4:
        model = 'gpt-4o'
    elif model_set_to_mini:
        model = 'gpt-5-mini'
    elif model_set_to_nano:
        model = 'gpt-5-nano'
    elif model_set_to_codex:
        model = 'gpt-5-codex'
    # -5 flag or default keeps model='gpt-5'

    # Validate that only GPT-4o and GPT-5 models are allowed
    validate_model(model)

    # Token counting mode
    if tokens:
        if repl:
            raise click.UsageError("Cannot use --tokens with --repl mode")
        if all_files:
            raise click.UsageError("Cannot use --tokens with --file/--pdf (tokens are for text only)")

        text = sys.stdin.read()

        # Count tokens
        count, token_ids = count_tokens(text, model)

        # Output as JSON
        result = {
            "token_count": count,
            "token_ids": token_ids,
            "model": model
        }
        print(json.dumps(result, indent=2))
        return

    if repl and all_files:
        raise click.UsageError("File attachments not supported in REPL mode")

    # Use merged file list (None if empty)
    files_to_attach = all_files if all_files else None

    if repl:
        # REPL mode - interactive conversation
        conversation_history = []
        click.echo(f"GPT REPL Mode (model: {model}). Type 'exit' to quit.")
        while True:
            try:
                content = input("> ")
            except (EOFError, KeyboardInterrupt):
                click.echo("\nExiting...")
                return

            if content.lower() in ["exit", "quit"]:
                return

            try:
                assistant_response = gpt(
                    content, model, temperature, top_p, stream, stop,
                    max_completion_tokens, reasoning_effort, verbosity, conversation_history,
                    file_attachments=None, detail=detail, timeout=timeout, debug=debug,
                    fail_after_chunks=fail_after_chunks
                )
                conversation_history.append({"role": "user", "content": content})
                conversation_history.append({"role": "assistant", "content": assistant_response})
                # Output already streamed by gpt()
            except Exception as e:
                click.echo(f"Error: {e}", err=True)
    else:
        # Standard filter mode - text in, text out
        message = sys.stdin.read()

        try:
            gpt(
                message, model, temperature, top_p, stream, stop,
                max_completion_tokens, reasoning_effort, verbosity, [],
                file_attachments=files_to_attach, detail=detail, timeout=timeout, debug=debug,
                fail_after_chunks=fail_after_chunks
            )
            # Output already streamed by gpt()
        except Exception as e:
            if debug:
                click.echo(f"[{ts()}] FATAL: {type(e).__name__}: {e}", err=True)
            else:
                click.echo(f"Error: {e}", err=True)
            sys.exit(1)


if __name__ == "__main__":
    main()  # pylint: disable=no-value-for-parameter

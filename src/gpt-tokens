#!/usr/bin/env python3
import tiktoken
import sys

def main():
    s = sys.stdin.read()
    # GPT-5 uses o200k_base encoding
    try:
        enc = tiktoken.encoding_for_model("gpt-5")
    except KeyError:
        # Fallback to gpt-4 encoding if gpt-5 not available yet
        enc = tiktoken.encoding_for_model("gpt-4")
    print(enc.encode(s))

if __name__ == "__main__":
    main()

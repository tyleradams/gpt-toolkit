#!/bin/sh
set -e

case "$1" in
    configure)
        # Install Python dependencies that aren't available as Debian packages
        # Install to /usr/local to avoid conflicts with dpkg
        pip3 install --no-warn-script-location openai>=1.0.0 tiktoken>=0.4.0 readline>=6.2.4.1 || true
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
